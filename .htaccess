SetEnv MIBDIRS "D:/xampp/php/extras/mibs"

# Prevent directory listing
Options -Indexes

# Default document
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Strip trailing slash for non-directories (e.g. /switches/ -> /switches, /tools/ -> /tools)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} \s/+(.+?)/+[?\s]
    RewriteRule ^(.*)/$ %1 [R=301,L]

    # Direct route for tools
    RewriteRule ^tools$ tools.php [L]

    # Externally redirect /file.php to /file (using %{THE_REQUEST} to preserve subfolder path and prevent Windows path disclosure)
    RewriteCond %{REQUEST_URI} !/api/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,NE,L]

    # Internally rewrite extensionless URL to .php file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>
